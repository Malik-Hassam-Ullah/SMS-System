    dataShopFromLiquidLAI.productMainInfo['product']= {"id":7762515787810,"title":"The Smart School Shirt","handle":"shirt-the-smart-school","description":"\u003cp\u003e \u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0738\/9406\/8258\/files\/shirt_size_chart.png?v=1761575975\" alt=\"\"\u003eThe Smart School Shirt – A Premium Uniform Shirt for Active Learners.\u003c\/strong\u003e\u003cbr\u003eSpecifically designed for students of The Smart School, this uniform shirt offers the perfect balance of comfort, durability, and style, ensuring students feel confident and look polished throughout the school day.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eKey Features:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eHigh-Quality Fabric:\u003c\/strong\u003e\u003cbr\u003eCrafted from soft and breathable materials, the Shirt - The Smart School offers superior comfort, allowing students to focus on their studies and activities without any discomfort.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eClassic Design:\u003c\/strong\u003e\u003cbr\u003eFeaturing a well-tailored fit and the school’s emblem, this shirt reflects professionalism and a sense of pride, perfectly aligning with The Smart School’s values.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eDurable Construction:\u003c\/strong\u003e\u003cbr\u003eBuilt to withstand daily wear, this shirt maintains its shape, crispness, and vibrant color even after multiple washes, ensuring it stays fresh and sharp throughout the school year.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eComfortable Fit:\u003c\/strong\u003e\u003cbr\u003eDesigned for a comfortable and relaxed fit, it allows for ease of movement, making it suitable for various school activities, from classroom lessons to sports and extracurricular events.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eEasy Maintenance:\u003c\/strong\u003e\u003cbr\u003eThe machine-washable fabric makes caring for the shirt simple and convenient, allowing parents to keep the uniform neat and tidy with minimal effort.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eVersatile Style:\u003c\/strong\u003e\u003cbr\u003ePerfectly suited for the classroom, this versatile shirt can also be worn for formal events, family gatherings, and other occasions, making it an essential part of any student's wardrobe.\u003c\/p\u003e\n\u003cp\u003eChoose the \u003cstrong\u003eShirt - The Smart School\u003c\/strong\u003e for a combination of quality, comfort, and style that enhances your child’s educational experience while fostering pride in being part of The Smart School community.\u003c\/p\u003e","published_at":"2024-07-27T16:22:10+05:00","created_at":"2024-07-27T16:16:45+05:00","vendor":"Alfajr Store","type":"School Shirt for Boys","tags":["School Shirt"],"price":80000,"price_min":80000,"price_max":150000,"available":true,"price_varies":true,"compare_at_price":null,"compare_at_price_min":0,"compare_at_price_max":0,"compare_at_price_varies":false,"variants":[{"id":42929340809250,"title":"18","option1":"18","option2":null,"option3":null,"sku":null,"requires_shipping":true,"taxable":false,"featured_image":{"id":39029769732130,"product_id":7762515787810,"position":2,"created_at":"2026-02-22T12:55:42+05:00","updated_at":"2026-02-22T12:55:55+05:00","alt":null,"width":1248,"height":832,"src":"\/\/alfajrstore.com.pk\/cdn\/shop\/files\/SMART_SCHOOL_bd31fdcc-6c5f-4259-b9cf-d0e69ca7d491.png?v=1771746955","variant_ids":[42929340809250,42929340842018,42929340874786,42929340907554,42929340940322,42929340973090,42929341005858,42929341038626,42929341071394,42929341104162,42929341136930,42929341169698]},"available":true,"name":"The Smart School Shirt - 18","public_title":"18","options":["18"],"price":80000,"weight":200,"compare_at_price":null,"inventory_management":"shopify","barcode":null,"featured_media":{"alt":null,"id":29964569477154,"position":2,"preview_image":{"aspect_ratio":1.5,"height":832,"width":1248